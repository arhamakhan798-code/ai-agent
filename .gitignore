# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — TechMart Enterprise RAG Agent
# ─────────────────────────────────────────────────────────────────────────────

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment and sensitive keys (CRITICAL - DO NOT COMMIT TO PUBLIC REPO)
.env
.env.local
techmart-database-*.json
client_secret*.json
gmail_token.json
pip_freeze.txt
service_account_oneliner.txt

# Local databases (Railway uses a volume; never commit DB files)
*.db
*.sqlite
*.sqlite3

# Local Vector Database
chroma_db/

# Scratch / temp
scratch/
.pytest_cache/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

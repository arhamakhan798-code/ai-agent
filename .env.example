# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env for local dev.
# On Railway: add each variable in the Railway dashboard → Variables tab.
# NEVER commit the real .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI / LLM ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash-lite

# ── Google Sheets Sync ───────────────────────────────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_SHEET_NAME=Product Details
SYNC_POLL_INTERVAL_SECONDS=30

# ── Google Service Account ───────────────────────────────────────────────────
# Option A (local): path to the JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./techmart-database-a6718d22604c.json

# Option B (Railway / production): paste the ENTIRE JSON content as a single line
# Get the content with: python -c "import json,open; print(json.dumps(json.load(open('techmart-database-a6718d22604c.json'))))"
# Then set this variable in Railway dashboard:
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (fine for Railway with a volume attached)
# Or set to a PostgreSQL URL for production:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── Railway Volume ────────────────────────────────────────────────────────────
# Set automatically by Railway when you attach a Volume.
# Leave blank for local dev.
RAILWAY_VOLUME_MOUNT_PATH=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_API_KEY=change_this_to_a_strong_random_key

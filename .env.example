# ==============================================================================
# TechMart AI Agent - Environment Configuration
# ==============================================================================

# AI Model Provider Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Service Account (Paste the JSON string from techmart-database-*.json)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'

# Gmail API OAuth Token (Paste the JSON string from gmail_token.json)
GMAIL_TOKEN_JSON='{"token": "...", "refresh_token": "...", ...}'

# Server Port (optional, defaults to 5000 or cloud-assigned PORT)
PORT=5000
